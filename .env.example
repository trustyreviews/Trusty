# Draft with AI — only this line is required for local AI.
# Get a free-tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Facebook Page reviews (server-side only — never EXPO_PUBLIC_*)
# ---------------------------------------------------------------------------
# Permanent Page token (does not expire). Generate once:
#   1. Set FB_APP_ID, FB_APP_SECRET, FB_SHORT_USER_TOKEN below
#   2. npm run fb:page-token -- --write
# See README "Permanent Page token" for Step 1 (Graph API Explorer User token).
FB_APP_ID=2462222147604346
FB_APP_SECRET=
FB_SHORT_USER_TOKEN=

FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=1231064900087363
# FB_GRAPH_VERSION=v25.0

# Optional: public API for trustydirect.com (used by npm run build:web).
# PRODUCTION_API_BASE_URL=https://your-app.vercel.app
# Local/dev API base URL for the Expo app (npm run api → :3000).
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
