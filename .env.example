# Server-side only. Used by the /api/optimize-reply serverless function.
# Never expose this in the client/app bundle. Get a free-tier key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Client-side base URL for the serverless API (NO trailing slash).
# Required for physical devices and simulators — relative "/api/..." paths
# have no host on native, and "localhost" points at the device itself.
#
# Local: http://<your-LAN-IP>:3000
#   - Find your IP: `ipconfig` (Windows) / `ip addr` (Linux) / System Settings (macOS)
#   - Port 3000 is the default for `npm run api` (`vercel dev --listen 3000`)
# Deployed: https://your-app.vercel.app
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.64:3000
